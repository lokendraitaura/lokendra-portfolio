# ─── Site ───────────────────────────────────────────────────────────────
# Your live domain (used for SEO: canonical URL, sitemap, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://lokendra.work

# Google Search Console → "HTML tag" verification → paste only the content="..." value
GOOGLE_SITE_VERIFICATION=

# ─── Contact form delivery ──────────────────────────────────────────────
# Where messages are delivered
CONTACT_TO_EMAIL=lokendraitaura@gmail.com

# Option 1 (recommended): Gmail SMTP — instant delivery + automatic thank-you reply to the visitor
#   1. Turn on 2-Step Verification on the Google account
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#   3. Paste the 16-character password below (spaces are fine)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=lokendraitaura@gmail.com
SMTP_PASS=

# Option 2: Web3Forms (free) — create an access key with your email at https://web3forms.com
WEB3FORMS_ACCESS_KEY=

# Option 3 (automatic fallback, no setup): FormSubmit.co
#   The first message sends a one-time "Activate form" email to CONTACT_TO_EMAIL — click it once.
#   Set to 1 to turn this fallback off.
CONTACT_DISABLE_FORMSUBMIT=

# Browser-side Web3Forms key (public by design): get it at https://web3forms.com
NEXT_PUBLIC_WEB3FORMS_KEY=
